# cert-manager pins (INFRA-012). Plain KEY="value" lines only, sourced by install.sh.
# Bump the chart version here and nowhere else; Renovate watches the annotation below.
# renovate: datasource=helm depName=cert-manager registryUrl=https://charts.jetstack.io
CERT_MANAGER_CHART_VERSION="v1.21.2"
CERT_MANAGER_CHART_REPO="https://charts.jetstack.io"
CERT_MANAGER_NAMESPACE="cert-manager"
CERT_MANAGER_RELEASE="cert-manager"
