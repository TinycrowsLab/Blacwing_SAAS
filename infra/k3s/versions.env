# Blackwing dev k3s pins (DEVENV-014).
#
# Sourced by infra/k3s/install-dev.sh and infra/k3s/verify.sh next to
# infra/versions.env (the runsc, kubectl and helm pins live there). Plain
# KEY="value" lines only. Bump a version and its checksums in the same commit
# (values come from the release's published sha256sum file).

# --- k3s single-node server (release binary, sha256) -------------------------
# renovate: datasource=github-releases depName=k3s-io/k3s
K3S_VERSION="v1.37.1+k3s1"
K3S_SHA256_AMD64="92b94582eb7b34a8cf532e6006842b9ed215a6783cf56a3dd6271fd35243b2c0"
K3S_SHA256_ARM64="a1561ca4aef8b99f5588a840d4468ac39c8c1cd92470bbcb9634823fa221741a"

# --- k3d substitute (hosts without gVisor): same k3s version, image by digest -
K3S_IMAGE="rancher/k3s:v1.37.1-k3s1@sha256:ca7f37d993d82ef0dcdcfecb2e0e2618ea541dbaffc620c8cedebe01a82acd0d"
K3D_CLUSTER="bw-dev"
# Pod sandbox (pause) image of that k3s release, preloaded into the k3d node.
K3S_PAUSE_IMAGE="rancher/mirrored-pause:3.10.2@sha256:f548e0e8e3dc1896ca956272154dde3314e8cc4fde0a57577ee9fa1c63f5baf4"

# --- Probe / placeholder image (sandbox example, probes, dev placeholders) ----
PROBE_IMAGE="busybox:1.37.0@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e"

# --- Minimum host resources for the k3s path (below this: use Docker + runsc) -
K3S_MIN_CPUS="4"
K3S_MIN_MEM_MB="7680"
