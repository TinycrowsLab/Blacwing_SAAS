{
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "attributes": {
    "acr.loa.map": "{\"password\":1,\"strong\":2}",
    "bw.environment": "${BW_ENVIRONMENT}",
    "frontendUrl": "${BW_KEYCLOAK_PUBLIC_URL}"
  },
  "browserFlow": "blackwing browser",
  "bruteForceProtected": true,
  "clientScopes": [
    {
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "false"
      },
      "description": "Blackwing tenantId and roles claims",
      "name": "bw-claims",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "config": {
            "access.token.claim": "true",
            "claim.name": "tenantId",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "jsonType.label": "String",
            "multivalued": "false",
            "user.attribute": "tenantId",
            "userinfo.token.claim": "true"
          },
          "name": "tenantId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper"
        },
        {
          "config": {
            "access.token.claim": "true",
            "claim.name": "roles",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true"
          },
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper"
        },
        {
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.client.audience": "blackwing-api",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          },
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper"
        }
      ]
    }
  ],
  "clients": [
    {
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false",
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${BW_CONSOLE_ORIGIN}/"
      },
      "clientId": "blackwing-console",
      "consentRequired": false,
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email", "bw-claims"],
      "directAccessGrantsEnabled": false,
      "enabled": true,
      "frontchannelLogout": false,
      "implicitFlowEnabled": false,
      "name": "Blackwing console (BFF)",
      "optionalClientScopes": ["offline_access"],
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": ["${BW_CONSOLE_ORIGIN}/auth/callback"],
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "webOrigins": ["${BW_CONSOLE_ORIGIN}"]
    },
    {
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false"
      },
      "clientAuthenticatorType": "client-secret",
      "clientId": "blackwing-api",
      "consentRequired": false,
      "defaultClientScopes": ["acr", "profile", "roles", "bw-claims"],
      "directAccessGrantsEnabled": false,
      "enabled": true,
      "frontchannelLogout": false,
      "implicitFlowEnabled": false,
      "name": "Blackwing API",
      "optionalClientScopes": [],
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${BW_KEYCLOAK_API_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false
    },
    {
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false"
      },
      "clientAuthenticatorType": "client-secret",
      "clientId": "blackwing-cli",
      "consentRequired": false,
      "defaultClientScopes": ["acr", "profile", "roles", "bw-claims"],
      "directAccessGrantsEnabled": false,
      "enabled": true,
      "frontchannelLogout": false,
      "implicitFlowEnabled": false,
      "name": "Blackwing CLI / CI tokens",
      "optionalClientScopes": [],
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${BW_KEYCLOAK_CLI_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false
    }
  ],
  "displayName": "Blackwing",
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "enabled": true,
  "failureFactor": 5,
  "loginWithEmailAllowed": true,
  "maxDeltaTimeSeconds": 43200,
  "maxFailureWaitSeconds": 900,
  "mfa": {
    "description": "Local-account MFA (IAM-005). Second factor is TOTP or WebAuthn; a user with neither is sent to enrolment.",
    "flow": {
      "alias": "blackwing browser",
      "executions": [
        {
          "provider": "auth-cookie",
          "requirement": "ALTERNATIVE"
        },
        {
          "provider": "identity-provider-redirector",
          "requirement": "ALTERNATIVE"
        },
        {
          "alias": "blackwing forms",
          "requirement": "ALTERNATIVE",
          "children": [
            {
              "provider": "auth-username-password-form",
              "requirement": "REQUIRED"
            },
            {
              "alias": "blackwing conditional OTP",
              "requirement": "CONDITIONAL",
              "children": [
                {
                  "provider": "conditional-user-configured",
                  "requirement": "REQUIRED"
                },
                {
                  "provider": "auth-otp-form",
                  "requirement": "REQUIRED"
                }
              ]
            },
            {
              "alias": "blackwing conditional WebAuthn",
              "requirement": "CONDITIONAL",
              "children": [
                {
                  "provider": "conditional-user-configured",
                  "requirement": "REQUIRED"
                },
                {
                  "provider": "webauthn-authenticator",
                  "requirement": "REQUIRED"
                }
              ]
            }
          ]
        }
      ]
    },
    "requiredActions": [
      {
        "alias": "CONFIGURE_TOTP",
        "name": "Configure OTP",
        "enabled": true,
        "defaultAction": false,
        "priority": 10
      },
      {
        "alias": "webauthn-register",
        "name": "Register security key",
        "enabled": true,
        "defaultAction": false,
        "priority": 70
      }
    ]
  },
  "minimumQuickLoginWaitSeconds": 60,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespan": 5184000,
  "offlineSessionMaxLifespanEnabled": true,
  "organizationsEnabled": true,
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyCodeReusable": false,
  "otpPolicyDigits": 6,
  "otpPolicyInitialCounter": 0,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyType": "totp",
  "permanentLockout": false,
  "quickLoginCheckMilliSeconds": 1000,
  "realm": "blackwing",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      {
        "attributes": {
          "bw.scope": ["tenant"]
        },
        "description": "AppSec Engineer",
        "name": "appsec-engineer"
      },
      {
        "attributes": {
          "bw.scope": ["tenant"]
        },
        "description": "Asset Owner",
        "name": "asset-owner"
      },
      {
        "attributes": {
          "bw.scope": ["tenant"]
        },
        "description": "Developer",
        "name": "developer"
      },
      {
        "attributes": {
          "bw.scope": ["tenant"]
        },
        "description": "Org admin",
        "name": "org-admin"
      },
      {
        "attributes": {
          "bw.scope": ["tenant"]
        },
        "description": "Auditor",
        "name": "auditor"
      },
      {
        "attributes": {
          "bw.scope": ["tenant"]
        },
        "description": "CI/CD pipeline",
        "name": "ci-pipeline"
      },
      {
        "attributes": {
          "bw.scope": ["platform"]
        },
        "description": "Tinycrows platform operator",
        "name": "platform-operator"
      }
    ]
  },
  "sslRequired": "external",
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "verifyEmail": true,
  "waitIncrementSeconds": 60,
  "webAuthnPolicyAcceptableAaguids": [],
  "webAuthnPolicyAttestationConveyancePreference": "none",
  "webAuthnPolicyAuthenticatorAttachment": "not specified",
  "webAuthnPolicyAvoidSameAuthenticatorRegister": false,
  "webAuthnPolicyCreateTimeout": 0,
  "webAuthnPolicyRequireResidentKey": "not specified",
  "webAuthnPolicyRpEntityName": "Blackwing",
  "webAuthnPolicyRpId": "",
  "webAuthnPolicySignatureAlgorithms": ["ES256"],
  "webAuthnPolicyUserVerificationRequirement": "required"
}
