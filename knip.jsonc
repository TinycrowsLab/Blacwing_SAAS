{
  // FOUND-018 (#20). Dead-code, unused-export and unused-dependency gate: `pnpm knip` (CI: `pnpm knip --max-issues=0`).
  // Entry points come from each package.json (`exports`, `bin`, `scripts`) plus the Vitest/Next/Nest plugins,
  // so only exceptions are listed here. Each one says why it is needed.
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["**/generated/**", "scripts/fixtures/**"],
  "ignoreFiles": ["**/*.config.*"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"],
      // gofmt ships with the Go toolchain (lint-staged formats Go files with it); shellcheck is a system
      // package (the infra/bootstrap.sh self-test lints with it). trivy and openssl are system tools too (Trivy
      // gate, TLS setup tests), kubeconform lints the dev k3s manifests and helm renders the ingress charts. None is an npm binary.
      "ignoreBinaries": ["gofmt", "helm", "kubeconform", "openssl", "shellcheck", "trivy"],
      // Loaded by name at run time, never imported: semantic-release plugins named in release.config.mjs (CI-016) and
      // @vitest/coverage-v8, picked by `--coverage.provider=v8` (pnpm test:ci, CI-003).
      "ignoreDependencies": [
        "@semantic-release/github",
        "@semantic-release/release-notes-generator",
        "@vitest/coverage-v8",
        "conventional-changelog-conventionalcommits",
      ],
    },
    "apps/*": {
      // Entry points come from each app's package.json scripts and exports (src/index.ts, src/main.ts).
      "project": ["src/**/*.{ts,tsx}"],
    },
    "apps/model-gateway": {
      // Composition root started by the service image; no package.json script names it.
      "entry": ["src/main.ts"],
    },
    "apps/web": {
      // Next.js App Router files are loaded by the framework by file name (CONSOLE-001), never imported.
      "entry": ["src/app/**/{error,layout,loading,not-found,page,providers}.tsx"],
    },
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}"],
    },
    "packages/ui": {
      // The Tailwind preset names the compiled stylesheet by specifier (`@blackwing/ui/styles.css`), so .css is project-scoped.
      "project": ["src/**/*.{ts,tsx,css}"],
    },
    "apps/worker": {
      // The outbox relay (WORKFLOW-012) is a library until the worker composition root starts it (it needs a
      // tenant-status lookup, the bw_relay login and the Valkey/Temporal clients, which no issue provides yet).
      "entry": ["src/outbox/index.ts"],
    },
    "apps/api": {
      // Spawned as a child process by shutdown.process.test.ts (never imported).
      "entry": ["src/testdata/slow-server.ts"],
      // Served from node_modules by path at run time (docs UI static assets), never imported.
      "ignoreDependencies": ["swagger-ui-dist", "@types/swagger-ui-dist"],
    },
    "packages/db": {
      // Read by path as the drifted-schema fixture of migrate.int.test.ts (never imported).
      "ignore": ["src/check/testdata/drifted-schema.ts"],
    },
    "packages/config": {
      // Spawned as a child process by bootstrap.test.ts (never imported), so it has no static importer.
      "entry": ["src/testdata/bootstrap-app.ts"],
    },
    "packages/logger": {
      // Spawned as a child process by logger.process.test.ts (never imported).
      "entry": ["src/testdata/child-app.ts"],
      // Loaded by name as a pino transport target (worker thread), so no import statement exists.
      "ignoreDependencies": ["pino-pretty"],
    },
  },
}
