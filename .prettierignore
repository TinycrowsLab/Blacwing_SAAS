# Prettier ignore list (FOUND-004). Prettier also skips everything in .gitignore.

# Dependencies, build output and caches
node_modules/
dist/
build/
out/
coverage/
.next/
.turbo/
*.tsbuildinfo

# Lockfile: written by pnpm
pnpm-lock.yaml

# Generated code (OpenAPI/GraphQL clients, drizzle snapshots, ...). Keep in sync with the
# IGNORES list in eslint.config.mjs.
**/generated/
**/__generated__/
**/*.generated.*
**/*.gen.*

# Generated by tools and compared verbatim by tests
scripts/fixtures/turbo-build-dry.snapshot.json
packages/policy/src/schema.types.ts
eslint-report.json
boundaries-report.json
# Keycloak realm: canonical form is `JSON.stringify(_, null, 2)` from scripts/keycloak-realm.mjs (re-export)
infra/compose/keycloak/realm-export.json

# Deliberately failing lint fixtures (scripts/lint-config.test.mjs lints them as they are)
scripts/fixtures/eslint/

# Diagram and design exports (edited in draw.io / the design tool, not by hand)
*.drawio
docs/architecture/blackwing-architecture.html
design/

# Markdown is hand-wrapped prose with wide reference tables. Prettier would re-pad every table
# row. Markdown links are checked by scripts/check-claude-md.mjs and the docs link check (DOCS-001, #813).
*.md

# Generated by semantic-release on main (CI-016); never hand-edited.
CHANGELOG.md
