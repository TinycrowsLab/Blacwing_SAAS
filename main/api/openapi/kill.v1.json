    "/v1/kill/{id}": {
      "get": {
        "operationId": "getKillEvent",
        "summary": "A kill event with its halt timings",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The kill event.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KillEvent"
                },
                "examples": {
                  "halted": {
                    "value": {
                      "killEventId": "01890a5d-ac96-774b-bcce-b302099a8057",
                      "tenantId": "01890a5d-ac96-774b-bcce-b302099a8058",
                      "scope": "run",
                      "scopeRefId": "01890a5d-ac96-774b-bcce-b302099a8058",
                      "source": "api",
                      "actorType": "user",
                      "actorRef": "01890a5d-ac96-774b-bcce-b302099a8058",
                      "reason": "unexpected 5xx spike",
                      "status": "halted",
                      "triggeredAt": "2026-10-20T10:00:00.000Z",
                      "egressBlockedAt": "2026-10-20T10:00:00.400Z",
