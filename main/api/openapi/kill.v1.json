{
  "openapi": "3.1.0",
  "info": {
    "title": "Blackwing control-plane API: kill switch",
    "version": "1.0.0",
    "description": "Tenant kill trigger (F33, §8.5). Global kills are platform-operator only and use another path."
  },
  "paths": {
    "/v1/kill": {
      "post": {
        "operationId": "triggerKill",
        "summary": "Trigger the kill switch for a run, asset or the whole tenant",
        "description": "Requires kill:trigger and the Cedar Kill::trigger resource check. An asset_owner may kill only assets they own; only org_admin may kill the tenant. Propagation is asynchronous: poll the Location.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 255,
              "pattern": "^[\\x21-\\x7e]+$"
            },
            "example": "kill-7f3c2a9e-1"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KillTriggerRequest"
              },
              "examples": {
                "run": {
                  "summary": "Kill one run",
                  "value": {
                    "scope": "run",
                    "scopeRefId": "01890a5d-ac96-774b-bcce-b302099a8058",
                    "reason": "unexpected 5xx spike"
                  }
                },
                "asset": {
                  "summary": "Kill every run on an asset",
                  "value": {
                    "scope": "asset",
                    "scopeRefId": "01890a5d-ac96-774b-bcce-b302099a8058",
                    "reason": "change freeze"
                  }
                },
                "tenant": {
                  "summary": "Kill every run in the tenant",
                  "value": {
                    "scope": "tenant",
                    "reason": "incident declared"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Kill accepted. status is halted when nothing in scope was running.",
            "headers": {
              "Location": {
                "description": "URL of the kill event, /v1/kill/{killEventId}.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KillTriggerResponse"
                },
                "examples": {
                  "initiated": {
                    "value": {
                      "killEventId": "01890a5d-ac96-774b-bcce-b302099a8057",
                      "status": "initiated",
                      "triggeredAt": "2026-10-20T10:00:00.000Z"
                    }
                  },
                  "nothingRunning": {
                    "value": {
                      "killEventId": "01890a5d-ac96-774b-bcce-b302099a8057",
                      "status": "halted",
                      "triggeredAt": "2026-10-20T10:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Problem details; code is one of IDEMPOTENCY_KEY_REQUIRED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "IDEMPOTENCY_KEY_REQUIRED": {
                    "summary": "Idempotency key required",
                    "value": {
                      "type": "https://errors.blackwing.dev/IDEMPOTENCY_KEY_REQUIRED",
                      "title": "Idempotency key required",
                      "status": 400,
                      "code": "IDEMPOTENCY_KEY_REQUIRED",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Problem details; code is one of UNAUTHENTICATED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "UNAUTHENTICATED": {
                    "summary": "Authentication required",
                    "value": {
                      "type": "https://errors.blackwing.dev/UNAUTHENTICATED",
                      "title": "Authentication required",
                      "status": 401,
                      "code": "UNAUTHENTICATED",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Problem details; code is one of KILL_FORBIDDEN, KILL_GLOBAL_NOT_ALLOWED_HERE.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "KILL_FORBIDDEN": {
                    "summary": "Kill not permitted",
                    "value": {
                      "type": "https://errors.blackwing.dev/KILL_FORBIDDEN",
                      "title": "Kill not permitted",
                      "status": 403,
                      "code": "KILL_FORBIDDEN",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  },
                  "KILL_GLOBAL_NOT_ALLOWED_HERE": {
                    "summary": "Global kill is not allowed on this endpoint",
                    "value": {
                      "type": "https://errors.blackwing.dev/KILL_GLOBAL_NOT_ALLOWED_HERE",
                      "title": "Global kill is not allowed on this endpoint",
                      "status": 403,
                      "code": "KILL_GLOBAL_NOT_ALLOWED_HERE",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Problem details; code is one of NOT_FOUND.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "NOT_FOUND": {
                    "summary": "Resource not found",
                    "value": {
                      "type": "https://errors.blackwing.dev/NOT_FOUND",
                      "title": "Resource not found",
                      "status": 404,
                      "code": "NOT_FOUND",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Problem details; code is one of KILL_SCOPE_INVALID, KILL_REF_REQUIRED, VALIDATION_FAILED, IDEMPOTENCY_KEY_MISMATCH.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "KILL_SCOPE_INVALID": {
                    "summary": "Invalid kill scope",
                    "value": {
                      "type": "https://errors.blackwing.dev/KILL_SCOPE_INVALID",
                      "title": "Invalid kill scope",
                      "status": 422,
                      "code": "KILL_SCOPE_INVALID",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  },
                  "KILL_REF_REQUIRED": {
                    "summary": "Kill scope reference required",
                    "value": {
                      "type": "https://errors.blackwing.dev/KILL_REF_REQUIRED",
                      "title": "Kill scope reference required",
                      "status": 422,
                      "code": "KILL_REF_REQUIRED",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  },
                  "VALIDATION_FAILED": {
                    "summary": "Validation failed",
                    "value": {
                      "type": "https://errors.blackwing.dev/VALIDATION_FAILED",
                      "title": "Validation failed",
                      "status": 422,
                      "code": "VALIDATION_FAILED",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  },
                  "IDEMPOTENCY_KEY_MISMATCH": {
                    "summary": "Idempotency key reused with a different request",
                    "value": {
                      "type": "https://errors.blackwing.dev/IDEMPOTENCY_KEY_MISMATCH",
                      "title": "Idempotency key reused with a different request",
                      "status": 422,
                      "code": "IDEMPOTENCY_KEY_MISMATCH",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Problem details; code is one of INTERNAL.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "INTERNAL": {
                    "summary": "Internal server error",
                    "value": {
                      "type": "https://errors.blackwing.dev/INTERNAL",
                      "title": "Internal server error",
                      "status": 500,
                      "code": "INTERNAL",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listKillEvents",
        "summary": "The tenant's most recent kill events, newest first",
        "security": [
