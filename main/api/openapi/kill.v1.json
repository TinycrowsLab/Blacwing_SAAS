          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The kill history of the caller tenant, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KillEventList"
                },
                "examples": {
                  "history": {
                    "summary": "The newest kill of the tenant",
