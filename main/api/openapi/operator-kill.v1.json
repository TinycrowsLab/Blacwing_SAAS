    "/operator/v1/kill/events/{id}": {
      "get": {
        "operationId": "getOperatorKillEvent",
        "summary": "One kill with its measured phases and per-component results",
        "description": "A phase timestamp is null until the kill path confirmed it. status partially_halted or failed means components are still running; affected names them.",
        "security": [
          {
            "operatorSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The kill event.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorKillEventDetail"
                }
              }
            }
          },
          "401": {
            "description": "Problem details; code is one of UNAUTHENTICATED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "UNAUTHENTICATED": {
                    "summary": "Authentication required",
                    "value": {
                      "type": "https://errors.blackwing.dev/UNAUTHENTICATED",
                      "title": "Authentication required",
                      "status": 401,
                      "code": "UNAUTHENTICATED",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
