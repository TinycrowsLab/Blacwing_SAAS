  "components": {
    "securitySchemes": {
      "operatorSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "bw_operator_session"
      }
    },
    "schemas": {
      "OperatorBlastRadius": {
        "type": "object",
        "properties": {
          "runsAffected": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sandboxesAffected": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tenantsAffected": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sessionsAffected": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tenantSlug": {
            "type": "string",
            "minLength": 3,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": ["runsAffected", "sandboxesAffected", "tenantsAffected", "sessionsAffected"],
        "additionalProperties": false
      },
      "OperatorKillRequest": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": ["global", "tenant"]
          },
          "tenantId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": ["scope", "reason"],
        "additionalProperties": false
      },
      "KillTriggerResponse": {
        "type": "object",
        "properties": {
          "killEventId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "status": {
            "type": "string",
            "enum": ["initiated", "propagating", "halted", "partially_halted", "failed"]
          },
          "triggeredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
          }
        },
        "required": ["killEventId", "status", "triggeredAt"],
        "additionalProperties": false
      },
      "OperatorKillEventList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "scope": {
                  "type": "string",
                  "enum": ["global", "tenant"]
                },
                "tenantId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "actor": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "firedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
                },
                "haltMs": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": ["initiated", "propagating", "halted", "partially_halted", "failed"]
                }
              },
              "required": [
                "id",
                "scope",
                "tenantId",
