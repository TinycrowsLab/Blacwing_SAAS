        "security": [
          {
            "operatorSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "The kill history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorKillEventList"
                }
              }
            }
          },
          "401": {
            "description": "Problem details; code is one of UNAUTHENTICATED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
