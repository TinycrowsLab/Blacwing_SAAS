{
  "openapi": "3.1.0",
  "info": {
    "title": "Blackwing operator API: global kill control",
    "version": "1.0.0",
    "description": "Platform-operator kill (F33, §1.2, §8.5). Triggers the deterministic kill path and reports what it measured. Operator-only: a tenant session is refused with NOT_OPERATOR."
  },
  "paths": {
    "/operator/v1/kill/blast-radius": {
      "get": {
        "operationId": "previewOperatorKill",
        "summary": "What a global or tenant kill would stop right now",
        "description": "Audited as operator.kill_previewed. tenantSlug is present for scope=tenant.",
        "security": [
          {
            "operatorSession": []
          }
        ],
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["global", "tenant"]
            }
          },
          {
            "name": "tenantId",
            "in": "query",
            "required": false,
            "description": "Required for scope=tenant; forbidden for scope=global.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The blast radius.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorBlastRadius"
                },
                "example": {
                  "runsAffected": 3,
                  "sandboxesAffected": 5,
                  "tenantsAffected": 2,
                  "sessionsAffected": 4
                }
              }
            }
          },
          "401": {
            "description": "Problem details; code is one of UNAUTHENTICATED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "UNAUTHENTICATED": {
                    "summary": "Authentication required",
                    "value": {
                      "type": "https://errors.blackwing.dev/UNAUTHENTICATED",
                      "title": "Authentication required",
                      "status": 401,
                      "code": "UNAUTHENTICATED",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Problem details; code is one of NOT_OPERATOR.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "NOT_OPERATOR": {
                    "summary": "Platform operator required",
                    "value": {
                      "type": "https://errors.blackwing.dev/NOT_OPERATOR",
                      "title": "Platform operator required",
                      "status": 403,
                      "code": "NOT_OPERATOR",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Problem details; code is one of NOT_FOUND.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "NOT_FOUND": {
                    "summary": "Resource not found",
                    "value": {
                      "type": "https://errors.blackwing.dev/NOT_FOUND",
                      "title": "Resource not found",
                      "status": 404,
                      "code": "NOT_FOUND",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Problem details; code is one of VALIDATION_FAILED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "VALIDATION_FAILED": {
                    "summary": "Validation failed",
                    "value": {
                      "type": "https://errors.blackwing.dev/VALIDATION_FAILED",
                      "title": "Validation failed",
                      "status": 422,
                      "code": "VALIDATION_FAILED",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Problem details; code is one of INTERNAL.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "INTERNAL": {
                    "summary": "Internal server error",
                    "value": {
                      "type": "https://errors.blackwing.dev/INTERNAL",
                      "title": "Internal server error",
                      "status": 500,
                      "code": "INTERNAL",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/operator/v1/kill": {
      "post": {
        "operationId": "fireOperatorKill",
        "summary": "Fire a global or tenant kill",
        "description": "Propagation is asynchronous: poll the Location. A repeat of the same Idempotency-Key replays the first answer; another kill for a scope that already has one open is KILL_ALREADY_IN_PROGRESS. Audited as operator.kill_fired in the operator and affected-tenant streams.",
        "security": [
          {
            "operatorSession": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 255,
              "pattern": "^[\\x21-\\x7e]+$"
            },
            "example": "opkill-7f3c2a9e-1"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OperatorKillRequest"
              },
              "examples": {
                "global": {
                  "value": {
                    "scope": "global",
                    "reason": "platform incident"
                  }
                },
                "tenant": {
                  "value": {
                    "scope": "tenant",
                    "tenantId": "01890a5d-ac96-774b-bcce-b302099a8058",
                    "reason": "customer request"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Kill accepted. status is halted when nothing in scope was running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KillTriggerResponse"
                },
                "example": {
                  "killEventId": "01890a5d-ac96-774b-bcce-b302099a8057",
                  "status": "initiated",
                  "triggeredAt": "2026-10-20T10:00:00.000Z"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URL of the kill event, /operator/v1/kill/events/{killEventId}.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Problem details; code is one of IDEMPOTENCY_KEY_REQUIRED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "IDEMPOTENCY_KEY_REQUIRED": {
                    "summary": "Idempotency key required",
                    "value": {
                      "type": "https://errors.blackwing.dev/IDEMPOTENCY_KEY_REQUIRED",
                      "title": "Idempotency key required",
                      "status": 400,
                      "code": "IDEMPOTENCY_KEY_REQUIRED",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Problem details; code is one of UNAUTHENTICATED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "UNAUTHENTICATED": {
                    "summary": "Authentication required",
                    "value": {
                      "type": "https://errors.blackwing.dev/UNAUTHENTICATED",
                      "title": "Authentication required",
                      "status": 401,
                      "code": "UNAUTHENTICATED",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Problem details; code is one of NOT_OPERATOR.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "NOT_OPERATOR": {
                    "summary": "Platform operator required",
                    "value": {
                      "type": "https://errors.blackwing.dev/NOT_OPERATOR",
                      "title": "Platform operator required",
                      "status": 403,
                      "code": "NOT_OPERATOR",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Problem details; code is one of NOT_FOUND.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "NOT_FOUND": {
                    "summary": "Resource not found",
                    "value": {
                      "type": "https://errors.blackwing.dev/NOT_FOUND",
                      "title": "Resource not found",
                      "status": 404,
                      "code": "NOT_FOUND",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Problem details; code is one of KILL_ALREADY_IN_PROGRESS.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "KILL_ALREADY_IN_PROGRESS": {
                    "summary": "Kill already in progress",
                    "value": {
                      "type": "https://errors.blackwing.dev/KILL_ALREADY_IN_PROGRESS",
                      "title": "Kill already in progress",
                      "status": 409,
                      "code": "KILL_ALREADY_IN_PROGRESS",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Problem details; code is one of VALIDATION_FAILED, IDEMPOTENCY_KEY_MISMATCH.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "VALIDATION_FAILED": {
                    "summary": "Validation failed",
                    "value": {
                      "type": "https://errors.blackwing.dev/VALIDATION_FAILED",
                      "title": "Validation failed",
                      "status": 422,
                      "code": "VALIDATION_FAILED",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  },
                  "IDEMPOTENCY_KEY_MISMATCH": {
                    "summary": "Idempotency key reused with a different request",
                    "value": {
                      "type": "https://errors.blackwing.dev/IDEMPOTENCY_KEY_MISMATCH",
                      "title": "Idempotency key reused with a different request",
                      "status": 422,
                      "code": "IDEMPOTENCY_KEY_MISMATCH",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          },
          "424": {
            "description": "Problem details; code is one of KILL_PARTIAL.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "KILL_PARTIAL": {
                    "summary": "Kill only partly completed",
                    "value": {
                      "type": "https://errors.blackwing.dev/KILL_PARTIAL",
                      "title": "Kill only partly completed",
                      "status": 424,
                      "code": "KILL_PARTIAL",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Problem details; code is one of INTERNAL.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "INTERNAL": {
                    "summary": "Internal server error",
                    "value": {
                      "type": "https://errors.blackwing.dev/INTERNAL",
                      "title": "Internal server error",
                      "status": 500,
                      "code": "INTERNAL",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Problem details; code is one of TEMPORAL_UNAVAILABLE.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "TEMPORAL_UNAVAILABLE": {
                    "summary": "Temporal unavailable",
                    "value": {
                      "type": "https://errors.blackwing.dev/TEMPORAL_UNAVAILABLE",
                      "title": "Temporal unavailable",
                      "status": 503,
                      "code": "TEMPORAL_UNAVAILABLE",
                      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/operator/v1/kill/events": {
