{
  "problemMatcher": [
    {
      "owner": "bw-eslint",
      "pattern": [
        {
          "regexp": "^([^\\s:][^:]*):(\\d+):(\\d+): (error|warning) (.*?)(?: \\[(\\S+)\\])?$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5,
          "code": 6
        }
      ]
    }
  ]
}
