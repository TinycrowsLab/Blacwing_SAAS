{
  "name": "@blackwing/workflow-shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Temporal plumbing: connection config, typed client factory and the payload data converter",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
