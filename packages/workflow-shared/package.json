    "@blackwing/logger": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@temporalio/client": "catalog:",
    "@temporalio/common": "catalog:"
  },
  "devDependencies": {
    "@blackwing/testing": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
