{
  "name": "@blackwing/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle ORM schema, SQL migrations and tenant-scoped (RLS) data access",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./owner": "./src/owner.ts",
    "./roles.sql": "./src/roles.sql",
    "./migrations/*": "./migrations/*"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --config src/drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate-main.ts",
    "db:migrate:down": "tsx --env-file-if-exists=../../.env src/migrate-main.ts --down",
    "db:check": "vitest run --configLoader runner --config src/vitest.int.config.ts src/check/drift.int.test.ts",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --configLoader runner --config src/vitest.config.ts",
    "test:int": "vitest run --configLoader runner --config src/vitest.int.config.ts",
    "typecheck": "tsc -b --pretty false",
    "db:ping": "tsx --env-file-if-exists=../../.env src/ping.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/seed/main.ts",
    "db:seed:reset": "tsx --env-file-if-exists=../../.env src/seed/main.ts --reset"
  },
  "dependencies": {
    "@blackwing/config": "workspace:*",
    "@blackwing/contracts": "workspace:*",
    "@blackwing/errors": "workspace:*",
    "@blackwing/ids": "workspace:*",
    "@blackwing/logger": "workspace:*",
    "@blackwing/time": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@blackwing/testing": "workspace:*",
    "fast-check": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
