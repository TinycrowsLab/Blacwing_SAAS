        "kill_events_tenant_isolation": {
          "name": "kill_events_tenant_isolation",
          "as": "PERMISSIVE",
          "for": "ALL",
          "to": ["bw_app"],
          "using": "tenant_id = current_setting('app.tenant_id')::uuid",
          "withCheck": "tenant_id = current_setting('app.tenant_id')::uuid"
        },
        "kill_events_operator_global": {
          "name": "kill_events_operator_global",
          "as": "PERMISSIVE",
          "for": "ALL",
          "to": ["bw_operator"],
          "using": "tenant_id IS NULL AND scope = 'global'",
          "withCheck": "tenant_id IS NULL AND scope = 'global'"
        }
      },
      "checkConstraints": {
        "kill_events_scope_check": {
          "name": "kill_events_scope_check",
          "value": "\"kill_events\".\"scope\" IN ('run', 'asset', 'tenant', 'global')"
        },
        "kill_events_source_check": {
          "name": "kill_events_source_check",
          "value": "\"kill_events\".\"source\" IN ('console', 'api', 'soc_link', 'operator', 'system')"
        },
        "kill_events_status_check": {
          "name": "kill_events_status_check",
          "value": "\"kill_events\".\"status\" IN ('initiated', 'propagating', 'halted', 'partially_halted', 'failed')"
        },
        "kill_events_scope_ref_check": {
          "name": "kill_events_scope_ref_check",
          "value": "(\"kill_events\".\"scope\" IN ('run', 'asset')) = (\"kill_events\".\"scope_ref_id\" IS NOT NULL)"
        },
        "kill_events_tenant_check": {
          "name": "kill_events_tenant_check",
          "value": "\"kill_events\".\"tenant_id\" IS NOT NULL OR \"kill_events\".\"scope\" = 'global'"
        },
        "kill_events_reason_check": {
          "name": "kill_events_reason_check",
          "value": "length(btrim(\"kill_events\".\"reason\")) > 0"
        },
        "kill_events_halt_ms_check": {
          "name": "kill_events_halt_ms_check",
          "value": "\"kill_events\".\"halt_ms\" IS NULL OR \"kill_events\".\"halt_ms\" >= 0"
        },
        "kill_events_affected_check": {
          "name": "kill_events_affected_check",
          "value": "jsonb_typeof(\"kill_events\".\"affected\") = 'object'"
        },
        "kill_events_reenabled_check": {
          "name": "kill_events_reenabled_check",
          "value": "(\"kill_events\".\"reenabled_at\" IS NULL) = (\"kill_events\".\"reenabled_by\" IS NULL)"
        }
