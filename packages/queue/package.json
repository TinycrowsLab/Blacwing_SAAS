{
  "name": "@blackwing/queue",
  "version": "0.0.0",
  "private": true,
  "description": "BullMQ queue and worker factory on Valkey for short, non-durable jobs: typed payloads, tenant-prefixed keys, retry policy and metrics",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --configLoader runner --config src/vitest.config.ts",
    "test:int": "vitest run --configLoader runner --config src/vitest.int.config.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@blackwing/config": "workspace:*",
    "@blackwing/errors": "workspace:*",
    "@blackwing/logger": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "bullmq": "5.58.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@blackwing/testing": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
