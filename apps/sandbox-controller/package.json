{
  "name": "@blackwing/sandbox-controller",
  "version": "0.0.0",
  "private": true,
  "description": "Creates and destroys per-run sandboxes (KubernetesDriver, DockerDriver), run networks and CA material",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --configLoader runner --config src/vitest.config.ts",
    "test:int": "vitest run --configLoader runner --config src/vitest.int.config.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@blackwing/config": "workspace:*",
    "@blackwing/contracts": "workspace:*",
    "@blackwing/errors": "workspace:*",
    "@blackwing/logger": "workspace:*",
    "@blackwing/secrets": "workspace:*",
    "@kubernetes/client-node": "1.4.0",
    "@opentelemetry/api": "catalog:",
    "@peculiar/x509": "2.0.0",
    "dockerode": "5.0.1",
    "fastify": "catalog:",
    "ioredis": "5.11.1",
    "prom-client": "catalog:",
    "reflect-metadata": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@blackwing/testing": "workspace:*",
    "@types/dockerode": "4.0.2",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
