{
  "name": "@blackwing/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js console with BFF route handlers for authentication",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "lint": "eslint . --max-warnings=0",
