    "@testing-library/user-event": "14.6.8",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@blackwing/config": "workspace:*",
    "@blackwing/contracts": "workspace:*",
    "@blackwing/domain": "workspace:*",
    "@blackwing/logger": "workspace:*",
    "@blackwing/ui": "workspace:*",
    "@hookform/resolvers": "6.0.0",
    "@opentelemetry/api": "catalog:",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "catalog:",
    "ioredis": "5.11.1",
    "jose": "6.2.13",
    "lucide-react": "1.61.0",
    "next": "15.5.28",
