{
  "name": "@blackwing/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS control-plane API (REST /v1, GraphQL /graphql, internal Run Broker API)",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "dev": "tsx watch src/main.ts",
    "graphql:generate": "tsx src/graphql/emit.ts",
    "graphql:persist": "tsx src/graphql/persist.ts",
    "graphql:persist:check": "tsx src/graphql/persist.ts --check",
    "lint": "eslint . --max-warnings=0",
    "openapi:check": "tsx src/openapi/emit.ts --check",
    "openapi:emit": "tsx src/openapi/emit.ts",
    "openapi:generate": "tsx src/openapi/emit.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run --configLoader runner --config src/vitest.config.ts",
    "test:int": "vitest run --configLoader runner --config src/vitest.int.config.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@blackwing/agents": "workspace:*",
    "@blackwing/audit": "workspace:*",
    "@blackwing/audit": "workspace:*",
    "@blackwing/config": "workspace:*",
    "@blackwing/contracts": "workspace:*",
    "@blackwing/crypto": "workspace:*",
    "@blackwing/db": "workspace:*",
    "@blackwing/domain": "workspace:*",
    "@blackwing/errors": "workspace:*",
    "@blackwing/events": "workspace:*",
    "@blackwing/evidence": "workspace:*",
    "@blackwing/ids": "workspace:*",
    "@blackwing/logger": "workspace:*",
    "@blackwing/memory": "workspace:*",
    "@blackwing/notify": "workspace:*",
    "@blackwing/secrets": "workspace:*",
    "@blackwing/telemetry": "workspace:*",
    "@blackwing/time": "workspace:*",
    "@cedar-policy/cedar-wasm": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/request-context": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/graphql": "catalog:",
    "@nestjs/mercurius": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/core": "catalog:",
    "drizzle-orm": "0.45.3",
    "dataloader": "catalog:",
    "fastify": "catalog:",
    "graphql": "catalog:",
    "jose": "6.2.13",
    "mercurius": "catalog:",
    "pg": "8.23.1",
    "prom-client": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "saxes": "6.0.0",
    "swagger-ui-dist": "5.34.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@blackwing/testing": "workspace:*",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@types/swagger-ui-dist": "3.30.6",
    "fast-check": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
