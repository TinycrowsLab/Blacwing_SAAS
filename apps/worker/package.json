{
  "name": "@blackwing/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Temporal workers: run orchestration, validation, scheduling, retention, exports, connectors, notifications",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
