{
  "name": "@blackwing/root",
  "version": "0.0.0",
  "private": true,
  "description": "Blackwing: authorised, human-gated autonomous security-assessment SaaS (monorepo root)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "preinstall": "node scripts/preinstall.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "test:e2e": "turbo run test:e2e",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "check:layout": "node scripts/check-layout.mjs",
    "check:claude-md": "node scripts/check-claude-md.mjs",
    "check:tsconfig": "node scripts/check-tsconfig.mjs",
    "check:turbo": "node scripts/check-turbo.mjs"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "catalog:"
  }
}
