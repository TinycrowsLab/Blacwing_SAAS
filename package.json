{
  "name": "@blackwing/root",
  "version": "0.0.0",
  "private": true,
  "description": "Blackwing: authorised, human-gated autonomous security-assessment SaaS (monorepo root)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "preinstall": "node scripts/preinstall.mjs",
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "check-env": "node scripts/check-env.mjs",
    "dev:deps": "node scripts/dev-deps.mjs up",
    "dev:deps:obs": "node scripts/dev-deps.mjs obs",
    "dev:deps:obs:smoke": "node scripts/obs-smoke.mjs",
    "dev:tls": "node scripts/dev-deps.mjs tls",
    "dev:openbao:bootstrap": "bash infra/compose/openbao/bootstrap.sh",
    "dev:deps:config": "node scripts/dev-deps.mjs config",
    "dev:deps:reset": "node scripts/dev-deps.mjs reset",
    "dev:deps:smoke": "node scripts/compose-smoke.mjs",
    "targets:up": "node scripts/targets.mjs up",
    "targets:down": "node scripts/targets.mjs down",
    "targets:reset": "node scripts/targets.mjs reset",
    "targets:smoke": "node scripts/targets.mjs smoke",
    "dev:keycloak:check": "node scripts/keycloak-realm.mjs check",
    "dev:keycloak:export": "node scripts/keycloak-realm.mjs export",
    "dev:keycloak:reset": "node scripts/keycloak-realm.mjs reset",
    "dev:keycloak:smoke": "node scripts/keycloak-smoke.mjs",
    "lint": "turbo run lint",
    "lint:root": "tsc -p scripts/tsconfig.json --pretty false && eslint . --max-warnings=0 --ignore-pattern \"apps/**\" --ignore-pattern \"packages/**\"",
    "lint:report": "eslint . --max-warnings=0 --format json --output-file eslint-report.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "test:e2e": "turbo run test:e2e",
    "test:ci": "node scripts/ci-unit.mjs",
    "test:hygiene": "node scripts/check-test-hygiene.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "check:layout": "node scripts/check-layout.mjs",
    "check:claude-md": "node scripts/check-claude-md.mjs",
    "check:adr": "node scripts/check-adr.mjs --quiet",
    "check:tsconfig": "node scripts/check-tsconfig.mjs",
    "check:turbo": "node scripts/check-turbo.mjs",
    "check:renovate": "node scripts/check-renovate.mjs",
    "check:actions": "node scripts/check-actions.mjs",
    "check:dependency-review": "node scripts/check-dependency-review.mjs",
    "openapi:generate": "pnpm -r --if-present run openapi:generate",
    "graphql:generate": "pnpm -r --if-present run graphql:generate",
    "db:generate": "pnpm -r --if-present run db:generate",
    "db:migrate": "pnpm --filter @blackwing/db run db:migrate",
    "check:drift": "node scripts/check-drift.mjs stale",
    "check:images": "node scripts/check-images.mjs",
    "check:codeql": "node scripts/check-codeql.mjs",
    "check:trivy": "node scripts/check-trivy.mjs ignore && node scripts/check-trivy.mjs wiring",
    "test:trivy": "node --test scripts/check-trivy.int.mjs",
    "check:github": "node scripts/check-github.mjs --quiet",
    "labels:check": "node scripts/sync-labels.mjs --check-docs",
    "labels:sync": "node scripts/sync-labels.mjs",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "boundaries:report": "node scripts/check-boundaries.mjs --json boundaries-report.json",
    "boundaries:docs": "node scripts/check-boundaries.mjs --write-docs",
    "commit:scopes": "node scripts/commit-scopes.mjs",
    "knip": "knip --max-issues=0",
    "knip:report": "knip --reporter json"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@commitlint/lint": "20.5.3",
    "@commitlint/load": "20.5.3",
    "@commitlint/types": "20.5.0",
    "@eslint/js": "9.39.5",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.6",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "1.6.27",
    "conventional-changelog-conventionalcommits": "9.1.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unicorn": "65.0.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "knip": "6.42.1",
    "lint-staged": "16.4.0",
    "prettier": "3.9.9",
    "semantic-release": "24.2.9",
    "turbo": "2.11.7",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.1",
    "yaml": "2.9.1"
  }
}
