# Dependencies
node_modules/
.pnpm-store/

# Build output and caches
dist/
build/
out/
.next/
.turbo/
coverage/
storybook-static/
*.tsbuildinfo

# Go build output (apps/egress-gateway)
/apps/egress-gateway/bin/

# Secrets and key material: never commit (CONTEXT_PACK §8.7)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Dev-only state written by scripts (OpenBao app token, file-mode init keys)
.bw-dev/

# Logs and reports
# Kill SLO chaos report output (KILL-008, eval/harness)
eval/harness/out/
*.log
eslint-report.json
boundaries-report.json
infra/.bootstrap-report.json
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local Claude Code worktrees and personal settings
.claude/worktrees/
.claude/settings.local.json

# mkcert output for the dev TLS proxy (DEVENV-013): certs and keys are never committed
infra/compose/tls/certs/
**/reports/junit-int.xml

# Playwright e2e output (CI-006)
playwright-report/
test-results/
dev-apps.log

# Next.js generated type reference (apps/web)
next-env.d.ts

# Demo runtime state (scripts/demo.mjs): logs and pids
.demo/

# k6 load-test JSON summaries (infra/perf, PERF-001); the directory itself is kept by .gitkeep.
infra/perf/results/*
!infra/perf/results/.gitkeep
