# Blackwing local development environment. Copy to `.env` (untracked) and fill the empty
# passwords with random values, e.g. `openssl rand -hex 16`. Dev credentials only; never reuse
# them anywhere else. DEVENV-003 owns the full catalogue; this block covers the core data
# services from DEVENV-002 (infra/compose/docker-compose.dev.yml).
#
# Use with: docker compose --env-file .env -f infra/compose/docker-compose.dev.yml up -d --wait

# --- PostgreSQL 16 (+pgvector, pgcrypto) -----------------------------------------------------
BW_DEV_POSTGRES_PORT=15432
BW_DEV_POSTGRES_DB=blackwing
# Bootstrap superuser: only the init scripts use it. Apps never connect as it.
BW_DEV_POSTGRES_SUPERUSER=bw_admin
BW_DEV_POSTGRES_SUPERUSER_PASSWORD=
# Migration owner (packages/db migrations). Owns the schema; NOSUPERUSER, NOBYPASSRLS.
BW_DEV_POSTGRES_MIGRATOR_USER=bw_migrator
BW_DEV_POSTGRES_MIGRATOR_PASSWORD=
# App role used by every service. NOBYPASSRLS: RLS always applies.
BW_DEV_POSTGRES_APP_USER=bw_app
BW_DEV_POSTGRES_APP_PASSWORD=
# DATABASE_URL=postgres://bw_app:<app password>@127.0.0.1:15432/blackwing
# MIGRATION_DATABASE_URL=postgres://bw_migrator:<migrator password>@127.0.0.1:15432/blackwing

# --- Valkey 8 ---------------------------------------------------------------------------------
BW_DEV_VALKEY_PORT=16379
BW_DEV_VALKEY_PASSWORD=
# VALKEY_URL=redis://:<valkey password>@127.0.0.1:16379/0

# --- Neo4j 5 Community ------------------------------------------------------------------------
BW_DEV_NEO4J_HTTP_PORT=17474
BW_DEV_NEO4J_BOLT_PORT=17687
# At least 8 characters (Neo4j rule).
BW_DEV_NEO4J_PASSWORD=
# NEO4J_URL=bolt://127.0.0.1:17687 (user neo4j)
