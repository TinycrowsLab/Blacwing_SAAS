# Blackwing local development environment (DEVENV-003). Copy to `.env` (untracked) or just run
# `pnpm dev:deps`, which creates `.env` from this file: every empty `*_PASSWORD=` gets a random dev
# value and `${KEY}` references expand to the value of an earlier key. Existing `.env` values are
# never overwritten. Check for missing keys with `pnpm check-env`.
#
# RULES
# - Placeholders only. `change-me-dev` marks a dev-only value that a bootstrap issue replaces; it is
#   never a real secret. Real secrets never go in this file (CONTEXT_PACK 8.7).
# - Empty means unset: @blackwing/config treats `KEY=` as missing, so a required key left empty
#   fails startup with reason `empty`.
# - [DEV-ONLY] entries must never appear in staging or production configuration. In those
#   environments @blackwing/config does not read `.env`; values come from OpenBao / the platform.
# - Host ports follow the fixed Blackwing dev map; override only on a clash.
#
# Compose use: docker compose --env-file .env -f infra/compose/docker-compose.dev.yml up -d --wait

# --- Process -----------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
# Never disable outside local debugging; the default is true.
TLS_VERIFY=true

# --- PostgreSQL 16 (+pgvector, pgcrypto) -----------------------------------------------------
BW_DEV_POSTGRES_PORT=15432
BW_DEV_POSTGRES_DB=blackwing
# Bootstrap superuser: only the init scripts use it. Apps never connect as it.
BW_DEV_POSTGRES_SUPERUSER=bw_admin
BW_DEV_POSTGRES_SUPERUSER_PASSWORD=
# Migration owner (packages/db migrations). Owns the schema; NOSUPERUSER, NOBYPASSRLS.
BW_DEV_POSTGRES_MIGRATOR_USER=bw_migrator
BW_DEV_POSTGRES_MIGRATOR_PASSWORD=
# App role used by every service. NOBYPASSRLS: RLS always applies.
BW_DEV_POSTGRES_APP_USER=bw_app
BW_DEV_POSTGRES_APP_PASSWORD=
DATABASE_URL=postgres://bw_app:${BW_DEV_POSTGRES_APP_PASSWORD}@127.0.0.1:15432/blackwing
MIGRATION_DATABASE_URL=postgres://bw_migrator:${BW_DEV_POSTGRES_MIGRATOR_PASSWORD}@127.0.0.1:15432/blackwing

# --- Valkey 8 ---------------------------------------------------------------------------------
BW_DEV_VALKEY_PORT=16379
BW_DEV_VALKEY_PASSWORD=
# The schema key is REDIS_URL (Valkey speaks the Redis protocol; see valkeyEnvShape in
# @blackwing/config). VALKEY_URL is an alias for tooling that expects that name.
REDIS_URL=redis://:${BW_DEV_VALKEY_PASSWORD}@127.0.0.1:16379/0
VALKEY_URL=redis://:${BW_DEV_VALKEY_PASSWORD}@127.0.0.1:16379/0

# --- Neo4j 5 Community ------------------------------------------------------------------------
BW_DEV_NEO4J_HTTP_PORT=17474
BW_DEV_NEO4J_BOLT_PORT=17687
# At least 8 characters (Neo4j rule).
BW_DEV_NEO4J_PASSWORD=
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=${BW_DEV_NEO4J_PASSWORD}

# --- Temporal ---------------------------------------------------------------------------------
BW_DEV_TEMPORAL_PORT=17233
BW_DEV_TEMPORAL_UI_PORT=18233
# Workflow-history retention for the dev namespace (raise it when debugging old runs, e.g. 168h).
BW_DEV_TEMPORAL_RETENTION=72h
BW_DEV_TEMPORAL_LOG_LEVEL=info
TEMPORAL_ADDRESS=127.0.0.1:17233
TEMPORAL_NAMESPACE=blackwing-dev
# mTLS to Temporal (staging/prod). When true, both PEM paths are required (TEMPORAL_TLS_MISCONFIGURED otherwise).
TEMPORAL_TLS_ENABLED=false
TEMPORAL_CLIENT_CERT_PATH=
TEMPORAL_CLIENT_KEY_PATH=

# --- Keycloak (realm blackwing-dev) -------------------------------------------------------------
KEYCLOAK_ISSUER_URL=http://127.0.0.1:18080/realms/blackwing-dev
KEYCLOAK_CLIENT_ID=blackwing-web
# Dev admin console login. The Keycloak bootstrap issue provisions the real dev value.
BW_DEV_KEYCLOAK_ADMIN=admin
BW_DEV_KEYCLOAK_ADMIN_PASSWORD=
# Google SSO is brokered by Keycloak only (never by the app). Optional: leave empty; export the
# values into the untracked `.env` from the owner's secrets file at dev-stack start.
BW_DEV_GOOGLE_CLIENT_ID=
BW_DEV_GOOGLE_CLIENT_SECRET=

# --- OpenBao (dev mode) -------------------------------------------------------------------------
OPENBAO_ADDR=http://127.0.0.1:18200
# [DEV-ONLY] dev-mode root token. The OpenBao bootstrap (DEVENV-005) provisions the real dev value.
OPENBAO_TOKEN=change-me-dev

# --- MinIO (S3-compatible object storage) -------------------------------------------------------
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
BW_DEV_MINIO_PORT=19000
BW_DEV_MINIO_CONSOLE_PORT=19001
BW_DEV_MINIO_ROOT_USER=bw_minio_root
# Admin credentials: used only by the minio-init job and the console. Apps never get them.
BW_DEV_MINIO_ROOT_PASSWORD=
# Scoped app identity (read/write on bw-* buckets, no admin, no version deletes).
BW_DEV_MINIO_APP_ACCESS_KEY=bw_app_s3
BW_DEV_MINIO_APP_PASSWORD=
# Default retention applied to every new object. Dev: GOVERNANCE 1 day. Prod S3: COMPLIANCE.
BW_DEV_MINIO_RETENTION_MODE=GOVERNANCE
BW_DEV_MINIO_RETENTION_DAYS=1
S3_ACCESS_KEY_ID=${BW_DEV_MINIO_APP_ACCESS_KEY}
S3_SECRET_ACCESS_KEY=${BW_DEV_MINIO_APP_PASSWORD}

# --- Dev TLS proxy (Traefik + mkcert, `pnpm dev:tls`) -----------------------------------------------
# https://app.bw.localhost:18443 etc. Use 443 only where unprivileged low ports are allowed.
BW_DEV_TRAEFIK_HTTPS_PORT=18443
BW_DEV_TRAEFIK_HTTP_PORT=18000
BW_DEV_TRAEFIK_DASHBOARD_PORT=18082
BW_TLS_UPSTREAM_WEB=http://host.docker.internal:3000
BW_TLS_UPSTREAM_API=http://host.docker.internal:13400
BW_TLS_UPSTREAM_KEYCLOAK=http://keycloak:8080
BW_TLS_UPSTREAM_JUICE=http://juice-shop:3000

# --- Mailpit (dev SMTP sink; mail never leaves the machine) ---------------------------------------
# SMTP on 11025, web UI on 18025 (container ports 1025/8025). Host ports are overridable if taken.
BW_DEV_MAILPIT_SMTP_PORT=11025
BW_DEV_MAILPIT_UI_PORT=18025
BW_DEV_MAILPIT_MAX_MESSAGES=500
SMTP_URL=smtp://127.0.0.1:11025
MAILPIT_UI_URL=http://127.0.0.1:18025

# --- interactsh (local out-of-band callback server) -----------------------------------------------
# Local-only mode: HTTP collaborator API on 18081, DNS on 15353 (udp+tcp), token-authenticated (the token is
# generated into .env by `pnpm dev:deps`). The dev domain is not publicly delegated; see infra/compose/README.md.
BW_DEV_INTERACTSH_HTTP_PORT=18081
BW_DEV_INTERACTSH_DNS_PORT=15353
BW_DEV_INTERACTSH_DOMAIN=oob.bw.localhost
BW_DEV_INTERACTSH_TOKEN=
INTERACTSH_URL=http://127.0.0.1:18081
INTERACTSH_TOKEN=${BW_DEV_INTERACTSH_TOKEN}

# --- Observability ----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:14318

# --- [DEV-ONLY] toggles: must never appear in staging or production ---------------------------------
# Enables Keycloak direct password login for local development and tests.
BW_DEV_PASSWORD_LOGIN_ENABLED=true

# --- Local vulnerable targets (profile `targets`, DEVENV-012; loopback-only host ports) ----------
BW_TARGET_JUICE_SHOP_URL=http://127.0.0.1:13000
BW_TARGET_JUICE_SHOP_PORT=13000
BW_TARGET_CRAPI_PORT=13010
BW_TARGET_VAMPI_PORT=13020
BW_TARGET_DVGA_PORT=13030
BW_TARGET_DVWA_PORT=13040
BW_TARGET_WEBGOAT_PORT=13050
